# MySQL Configuration (Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=sales_production

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# For Aiven MySQL Production:
# DB_HOST=your-mysql-service.aivencloud.com
# DB_PORT=3306
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_NAME=defaultdb
# DB_CA_CERT=./config/ca.pem  # Path to downloaded Aiven CA certificate
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend.vercel.app
